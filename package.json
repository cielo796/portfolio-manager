{
  "name": "portfolio-manager",
  "version": "0.1.0",
  "private": true,
  "productName": "Portfolio Manager",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--require=./scripts/node-readlink-eisdir-fix.cjs next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "desktop": "npm run desktop:start",
    "desktop:dev": "node electron/desktop-runner.mjs dev",
    "desktop:start": "node electron/desktop-runner.mjs start",
    "desktop:shortcuts": "node scripts/create-shortcuts.mjs",
    "test:desktop": "vitest run --config electron/vitest.config.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.7.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wait-on": "^9.0.3"
  }
}
